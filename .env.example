# Public build settings: export variables before npm run build:pages.
# Plain static HTML is used, so NEXT_PUBLIC_/VITE_ prefixes do not apply.
# Do not commit .env or .dev.vars. The build does not automatically read either.
AMAZON_PARTNER_TAG=mcstarrstud0c-21
EBAY_CAMPAIGN_ID=
ENABLE_ADS=false
ENABLE_EXTERNAL_TELEMETRY=false
ENABLE_SPONSORED_DEMOS=false
ENABLE_VERIFIED_GIFTS=false
TELEMETRY_PROVIDER=
AD_SCRIPT_URL=
AD_ALLOWED_HOST=
AWIN_AFFILIATE_ID=3146453
AWIN_IMAGE_HOSTS=
CJ_PUBLISHER_ID=
SKIMLINKS_ID=

# Every merchant/network must be individually approved.
# CJ_LINK_ID is the approved CJ tracking link/ad ID, not a merchant account ID.
ETSY_AWIN_APPROVED=false
ETSY_AWIN_MERCHANT_ID=
ETSY_CJ_APPROVED=false
ETSY_CJ_LINK_ID=
ETSY_SKIMLINKS_APPROVED=false
NOTHS_AWIN_APPROVED=false
NOTHS_AWIN_MERCHANT_ID=18484
NOTHS_CJ_APPROVED=false
NOTHS_CJ_LINK_ID=
NOTHS_SKIMLINKS_APPROVED=false
BUYAGIFT_AWIN_APPROVED=false
BUYAGIFT_AWIN_MERCHANT_ID=
BUYAGIFT_CJ_APPROVED=false
BUYAGIFT_CJ_LINK_ID=
BUYAGIFT_SKIMLINKS_APPROVED=false
VIRGIN_AWIN_APPROVED=false
VIRGIN_AWIN_MERCHANT_ID=
VIRGIN_CJ_APPROVED=false
VIRGIN_CJ_LINK_ID=
VIRGIN_SKIMLINKS_APPROVED=false
JOHNLEWIS_AWIN_APPROVED=false
JOHNLEWIS_AWIN_MERCHANT_ID=
JOHNLEWIS_CJ_APPROVED=false
JOHNLEWIS_CJ_LINK_ID=
JOHNLEWIS_SKIMLINKS_APPROVED=false

# Existing Awin programme settings; confirm Joined status and assigned terms before enabling.
# Public defaults persist in site/config/affiliates.config.js without exporting env.
ETHICALSUPERSTORE_AWIN_APPROVED=false
ETHICALSUPERSTORE_AWIN_MERCHANT_ID=3651
GREENTULIP_AWIN_APPROVED=false
GREENTULIP_AWIN_MERCHANT_ID=48159
VIRGINIAHAYWARD_AWIN_APPROVED=true
VIRGINIAHAYWARD_AWIN_MERCHANT_ID=2500

# Optional verified programme terms for routing, e.g. ETSY_AWIN_COMMISSION_RATE=5.
# Repeat <MERCHANT>_<NETWORK>_COMMISSION_RATE and _COOKIE_DAYS as appropriate.
ETSY_AWIN_COMMISSION_RATE=0
ETSY_AWIN_COOKIE_DAYS=0

# Worker-only settings/secrets. NEVER included in public build output.
# Keep Amazon discovery disabled until approved Creators API access is available.
# Existing eBay discovery is independent; retain production credentials in Wrangler.
AMAZON_PRODUCT_DISCOVERY_ENABLED=false
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
AWIN_PRODUCT_DISCOVERY_ENABLED=false
AWIN_PUBLISHER_ID=3146453
# Awin Create-a-Feed datafeed key (not the Publisher API OAuth2 token).
AWIN_DATAFEEDS_API_KEY=
# D1 binding and feed import are configured separately; use only joined advertiser IDs.
AWIN_ALLOWED_ADVERTISERS=
ANTHROPIC_API_KEY=
KNOWLEDGE_REUSE_ENABLED=true
TURNSTILE_SECRET=
IP_SALT=
# Ad/analytics hosts need matching Worker CSP settings only after privacy review.
MONETIZATION_AD_HOST=
MONETIZATION_ANALYTICS_HOST=
