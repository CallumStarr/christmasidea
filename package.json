{
  "name": "santas-helper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "build:pages": "node scripts/build-site-pages.mjs",
    "benchmark": "node scripts/run-benchmark.js",
    "benchmark:score": "node scripts/score-benchmark.js",
    "benchmark:compare": "node scripts/compare-prompts.js",
    "benchmark:replay:v3.3": "node scripts/engine-metrics.js --results=benchmarks/baselines/v3.3-pre-refactor/benchmark-results.json --case-set=v3.3-original --expected-cases=30 --replay",
    "benchmark:replay:v3.4": "node scripts/engine-metrics.js --results=benchmarks/v3.4/live-haiku/benchmark-results.json --expected-cases=50 --replay",
    "benchmark:review:prepare": "node scripts/create-paired-review.js",
    "validate-run": "node scripts/validate-run.js"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
